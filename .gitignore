.DS_Store
claude-companion/
.claude/worktrees/
.claude/docs/
__pycache__/
*.pyc
*.egg-info/
.venv/
dist/
data/
logs/

# Hook telemetry sinks (moved from ~/.claude 2026-08-12). High-churn append-only
# logs written by ~/.claude/hooks/lib.sh on every hook fire -- data, not source.
.sounding/telemetry/.hook-log.jsonl
.sounding/telemetry/.hook-pass-log.jsonl

# Generated telemetry reports. Rewritten in full on every run, so committing them
# means a diff per wake against a file nobody reads in git. The subcommand that
# writes each one is the interface; the artifact is not.
.sounding/telemetry/consistency.json
.sounding/telemetry/cascade-state.json
# 2.1MB full-rewrite dump (GUA-154) -- replaces the hidden VERDICT-TRAJECTORIES table
.sounding/telemetry/verdict-trajectories.json
